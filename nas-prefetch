#!/usr/bin/env bash
# Pre-load photos/videos from an NFS (NAS) folder into the local disk cache (FS-Cache),
# so viewing them afterwards (in XnView or any other viewer) runs at local-disk speed.
# Requires the mount to be set up with nas-cache-setup.sh. Progress window needs zenity.
#
# Usage: nas-prefetch [-r] [-i] [-n N] [-b LIMIT] [-g] PATH...
#   PATH      a folder, or a file (then its folder is used)
#   -r        include subfolders
#   -i        images only (skip videos)
#   -n N      only the first N files (alphabetical)
#   -b LIMIT  bandwidth limit: 50% (of the measured maximum), 5M (bytes/s), 40Mbit, or off
#   -g        show a progress window (default when not started from a terminal)
# Defaults can be set in ~/.config/nas-prefetch.conf (see README).
set -euo pipefail

IMAGES='jpg|jpeg|png|gif|bmp|tif|tiff|webp|heic|heif|avif|dng|cr2|cr3|nef|arw|orf|rw2|raf|pef|srw'
VIDEOS='mp4|mov|m4v|mkv|avi|mts|m2ts|3gp|wmv|webm|mpg|mpeg'

# Settings; override them in the config file
PARALLEL=4          # files read at the same time
BANDWIDTH=50%       # off, a percentage (50%) or a fixed rate (5M = 5 MiB/s, 40Mbit)
MEASURE_SECONDS=15  # percentage limit: measure the maximum speed for this many seconds...
MEASURE_FILES=10    # ...or this many files, whichever comes first
conf=${XDG_CONFIG_HOME:-$HOME/.config}/nas-prefetch.conf
# shellcheck source=/dev/null
[[ -f $conf ]] && source "$conf"

usage() { sed -n '6,13p' "$0"; exit 1; }
depth=(-maxdepth 1)
exts="$IMAGES|$VIDEOS"
limit=0
gui=false
[[ -t 1 ]] || gui=true
while getopts "rin:b:gh" opt; do
  case $opt in
    r) depth=() ;;
    i) exts="$IMAGES" ;;
    n) limit=$OPTARG ;;
    b) BANDWIDTH=$OPTARG ;;
    g) gui=true ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -gt 0 ]] || usage

# Bandwidth setting -> bw_mode (none, flat or pct) and bw_value (bytes/s or percent)
bw=${BANDWIDTH,,}
bw=${bw// /}
bw=${bw%/s}
[[ $bw == *bps ]] && bw=${bw%bps}bit  # Mbps = Mbit/s
if [[ -z $bw || $bw == off || $bw == none || $bw == 0 ]]; then
  bw_mode=none bw_value=0
elif [[ $bw =~ ^([0-9]+)%$ ]] && ((BASH_REMATCH[1] >= 1 && BASH_REMATCH[1] <= 100)); then
  bw_mode=pct bw_value=${BASH_REMATCH[1]}
elif [[ $bw =~ ^([0-9]+([.][0-9]+)?)([kmg]?)(bit|b)?$ ]]; then
  # Bytes use 1024 steps (like the progress display), bits use 1000 steps (like network speeds)
  bw_value=$(awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[3]}" -v bits="${BASH_REMATCH[4]}" 'BEGIN {
    p = (u == "") ? 0 : index("kmg", u); step = (bits == "bit") ? 1000 : 1024
    v = n * (p ? step ^ p : 1); if (bits == "bit") v /= 8; printf "%d", v }')
  bw_mode=flat
  ((bw_value > 0)) || bw_mode=none
else
  echo "Invalid bandwidth limit '$BANDWIDTH': use e.g. 50%, 5M, 40Mbit or off" >&2
  exit 1
fi

notify() {
  echo "$1"
  $gui && { notify-send -i image "NAS prefetch" "$1" 2>/dev/null || true; }
}
human() { numfmt --to=iec --suffix=B --format='%.1f' "$1"; }

# Unique folders from the given paths
mapfile -t dirs < <(for p in "$@"; do [[ -d $p ]] && echo "$p" || dirname "$p"; done | sort -u)

for d in "${dirs[@]}"; do
  if ! findmnt -no FSTYPE,OPTIONS -T "$d" | grep -q '^nfs.*[ ,]fsc\(,\|$\)'; then
    echo "Warning: $d is not on an NFS mount with the disk cache (fsc); files will only be cached in RAM."
  fi
done

# Window while listing; no Cancel button, so a stray Enter cannot stop anything
listwin=
if $gui; then
  exec 3> >(zenity --progress --pulsate --no-cancel --title="NAS prefetch" --width=500 \
    --text="Listing files in ${dirs[*]}..." 2>/dev/null)
  listwin=$!
fi

# "path<TAB>size" entries, sorted by path
mapfile -d '' entries < <(
  find "${dirs[@]}" "${depth[@]}" -type f -regextype posix-extended -iregex ".*\.($exts)$" -printf '%p\t%s\0' |
    sort -z | { if ((limit > 0)); then head -z -n "$limit"; else cat; fi; }
)

declare -A size
files=()
total=0
for e in "${entries[@]}"; do
  f=${e%$'\t'*}
  files+=("$f")
  size[$f]=${e##*$'\t'}
  total=$((total + size[$f]))
done

if [[ -n $listwin ]]; then exec 3>&-; kill "$listwin" 2>/dev/null || true; fi
count=${#files[@]}
((count > 0)) || { notify "No photos/videos found in ${dirs[*]}"; exit 0; }
((total > 0)) || total=1

# Folder of a file, shown relative to the parent of the prefetched folder (e.g. "2025/Holiday")
folder_of() {
  local where=${1%/*} d
  for d in "${dirs[@]}"; do
    d=${d%/}
    if [[ -n $d && ($where == "$d" || $where == "$d"/*) ]]; then
      where=${d##*/}${where#"$d"}
      break
    fi
  done
  echo "$where"
}

# Reads NUL-separated paths from stdin with PARALLEL threads under one shared bandwidth limit,
# and prints each path (NUL-terminated) once it has been read completely.
# On an NFS mount the limit and the measurement use the mount's network counter
# (/proc/self/mountstats): files already in the local cache are read at full speed and do not
# count. Elsewhere they use the bytes read.
# Percentage mode first runs at full speed until MEASURE_SECONDS or MEASURE_FILES is reached,
# then limits to that percentage of the measured speed. A measurement with less than 1 MiB of
# network traffic, or where most data came from the cache, starts over.
# Writes the current limit to INFOFILE: "measuring", or "limit BYTES_PER_S [MEASURED_MAX]",
# and the number of bytes read so far to READFILE twice per second. Once per second it also
# prints an empty entry (a lone NUL), so the progress display updates during large files.
# Time while the process is stopped (Pause) or suspended is not counted.
# Args: PARALLEL MODE(none|flat|pct) VALUE MEASURE_SECONDS MEASURE_FILES INFOFILE NFS_MOUNTPOINT
#       READFILE
READER=$(cat <<'PY'
import os, re, sys, threading, time

parallel, mode, value = int(sys.argv[1]), sys.argv[2], float(sys.argv[3])
measure_s, measure_n = float(sys.argv[4]), int(sys.argv[5])
infofile, mountpoint, readfile = sys.argv[6], sys.argv[7], sys.argv[8]
CHUNK = 1 << 20

files = sys.stdin.buffer.read().split(b"\0")
if files and files[-1] == b"":
    files.pop()
queue = iter(files)
lock = threading.Lock()
nread = ndone = 0


def write(path, text):
    with open(path + ".tmp", "w") as f:
        f.write(text + "\n")
    os.replace(path + ".tmp", path)


def info(text):
    write(infofile, text)


def report():
    tick = 0
    while True:
        write(readfile, str(nread))
        tick += 1
        if tick % 2 == 0:
            with lock:
                sys.stdout.buffer.write(b"\0")
                sys.stdout.buffer.flush()
        time.sleep(0.5)


def network_bytes():
    """Bytes this NFS mount has read from the server, or None if unavailable."""
    try:
        with open("/proc/self/mountstats") as f:
            section = False
            for line in f:
                if line.startswith("device "):
                    m = re.search(r" mounted on (\S+) with fstype nfs", line)
                    path = m and re.sub(r"\\([0-7]{3})", lambda o: chr(int(o.group(1), 8)), m.group(1))
                    section = bool(mountpoint) and path == mountpoint
                elif section and line.split()[:1] == ["bytes:"]:
                    return int(line.split()[5])  # serverreadbytes
    except (OSError, IndexError, ValueError):
        pass
    return None


# What the limit and the measurement count: network traffic of the mount, or bytes read
NETWORK = network_bytes() is not None
traffic = network_bytes if NETWORK else (lambda: nread)


class Bucket:
    """Token bucket shared by all threads; rate 0 means unlimited. A background thread adds
    `rate` bytes per second. Network traffic is subtracted by that thread as the counter rises,
    so cache hits cost nothing; without a network counter, readers subtract what they read.
    Readers wait while the bucket is negative."""

    def __init__(self, rate):
        self.lock = threading.Lock()
        self.rate, self.tokens = rate, 0.0
        threading.Thread(target=self.run, daemon=True).start()

    def set(self, rate):
        with self.lock:
            self.tokens, self.rate = 0.0, rate

    def run(self):
        last_t, last_b = time.monotonic(), traffic()
        while True:
            time.sleep(0.05)
            now, b = time.monotonic(), traffic()
            dt = min(now - last_t, 0.1)  # skip time spent paused
            with self.lock:
                if self.rate > 0:
                    # Cap the refill, so an idle moment does not lead to a burst afterwards
                    burst = max(self.rate / 2, CHUNK)
                    used = b - last_b if NETWORK else 0
                    self.tokens = min(self.tokens + dt * self.rate - used, burst)
            last_t, last_b = now, b

    def read(self, n):
        if not NETWORK:
            with self.lock:
                if self.rate > 0:
                    self.tokens -= n

    def wait(self):
        while self.rate > 0 and self.tokens < 0:
            time.sleep(0.05)


bucket = Bucket(value if mode == "flat" else 0)


def worker():
    global nread, ndone
    buf = bytearray(CHUNK)
    while True:
        with lock:
            path = next(queue, None)
        if path is None:
            return
        try:
            with open(path, "rb", buffering=0) as f:
                if bucket.rate > 0:
                    # No kernel read-ahead, so the network follows the limit smoothly
                    # instead of fetching 16 MB bursts at full speed
                    os.posix_fadvise(f.fileno(), 0, 0, os.POSIX_FADV_RANDOM)
                while True:
                    bucket.wait()
                    n = f.readinto(buf)
                    if not n:
                        break
                    with lock:
                        nread += n
                    bucket.read(n)
        except OSError as e:
            print(f"nas-prefetch: {e}", file=sys.stderr)
            continue
        with lock:
            ndone += 1
            sys.stdout.buffer.write(path + b"\0")
            sys.stdout.buffer.flush()


def measure():
    while True:
        net0, read0, files0, active, last = traffic(), nread, ndone, 0.0, time.monotonic()
        while active < measure_s and ndone - files0 < measure_n:
            time.sleep(0.1)
            now = time.monotonic()
            active += min(now - last, 0.1)  # skip time spent paused
            last = now
        got = traffic() - net0
        # Mostly read from the cache: that says nothing about the network, so try again
        if got >= CHUNK and got >= (nread - read0) / 2:
            break
    top = got / active
    limit = max(top * value / 100, 1024)
    bucket.set(limit)
    info(f"limit {limit:.0f} {top:.0f}")


threading.Thread(target=report, daemon=True).start()
if mode == "pct":
    info("measuring")
    threading.Thread(target=measure, daemon=True).start()
elif mode == "flat":
    info(f"limit {value:.0f}")
threads = [threading.Thread(target=worker) for _ in range(parallel)]
for t in threads:
    t.start()
for t in threads:
    t.join()
PY
)

# Temporary files: progress, seconds paused, bandwidth info
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
status=$tmp/status pausefile=$tmp/paused infofile=$tmp/bandwidth readfile=$tmp/read
echo 0 > "$pausefile"
echo 0 > "$readfile"
: > "$infofile"
nfs_mount=$(findmnt -no FSTYPE,TARGET -T "${dirs[0]}" | awk '$1 ~ /^nfs/ { sub(/^[^ ]+ +/, ""); print }')

# Bandwidth line for the progress text
bandwidth_text() {
  local kind lim top
  read -r kind lim top < "$infofile" || true
  case $kind in
    measuring) echo "Bandwidth: measuring maximum speed for the ${bw_value}% limit..." ;;
    limit)
      if [[ -n $top ]]; then
        echo "Bandwidth limit: $(human "$lim")/s (${bw_value}% of measured $(human "$top")/s)"
      else
        echo "Bandwidth limit: $(human "$lim")/s"
      fi ;;
  esac
}

# Reads the files, printing zenity-style progress: a percentage line and a "# text" line per file.
# The text lines are separated by a literal \n: the current folder, the totals, the bandwidth.
run() {
  local done=0 got shown n=0 f elapsed rate eta speed pct paused where bwtext now last=0
  local last_file=${files[0]}  # the folder shown is that of the last finished file
  # Speed and time left are based on the last minute: samples of time, bytes done, seconds paused
  local -a sample_t=() sample_done=() sample_paused=()
  printf '%s\0' "${files[@]}" |
    python3 -I -c "$READER" "$PARALLEL" "$bw_mode" "$bw_value" "$MEASURE_SECONDS" "$MEASURE_FILES" \
      "$infofile" "$nfs_mount" "$readfile" |
    while IFS= read -r -d '' f; do
      # An empty entry is the reader's once-per-second tick, not a finished file
      if [[ -n $f ]]; then
        done=$((done + size[$f]))
        n=$((n + 1))
        last_file=$f
      fi
      # Bytes read so far, including files still being read; the sum of finished files is the
      # minimum, as the reader only reports twice per second
      read -r got < "$readfile" || true
      ((${got:-0} > done)) && shown=$got || shown=$done
      # Update the text at most 4 times per second (it costs ~15 ms), and always for the last file
      now=${EPOCHREALTIME/[.,]/}
      ((n == count || now - last >= 250000)) || continue
      last=$now
      paused=0
      read -r paused < "$pausefile" || true
      paused=${paused:-0}
      sample_t+=("$now") sample_done+=("$shown") sample_paused+=("$paused")
      while ((${#sample_t[@]} > 2 && now - sample_t[1] >= 60000000)); do
        sample_t=("${sample_t[@]:1}") sample_done=("${sample_done[@]:1}") sample_paused=("${sample_paused[@]:1}")
      done
      # Microseconds since the oldest sample, minus the time paused since then
      elapsed=$(((now - sample_t[0]) - (paused - sample_paused[0]) * 1000000))
      if ((${#sample_t[@]} > 1 && elapsed > 0)); then
        rate=$(((shown - sample_done[0]) * 1000000 / elapsed))
      else
        rate=0
      fi
      if ((rate > 0)); then
        eta=$(((total - shown) / rate))
        if ((eta >= 3600)); then
          eta=$(printf '%dh%02dm' $((eta / 3600)) $((eta % 3600 / 60)))
        elif ((eta >= 60)); then
          eta="$((eta / 60))m"
        else
          eta="<1m"
        fi
        speed="$(human "$rate")/s  ·  ~$eta left"
      else
        speed="estimating time left..."
      fi
      where=$(folder_of "$last_file")
      where=${where//\\/\\\\}  # zenity unescapes the text
      bwtext=
      [[ $bw_mode == none ]] || bwtext="\\n$(bandwidth_text)"
      # Text before percentage: zenity --auto-close exits as soon as it reads 100
      printf '# Fetching: %s\\n%d of %d files  ·  %s of %s  ·  %s%s\n' \
        "$where" "$n" "$count" "$(human "$shown")" "$(human "$total")" "$speed" "$bwtext"
      # Only the last file may give 100: zenity --auto-close closes the window at 100
      if ((n == count)); then echo 100; else pct=$((shown * 100 / total)); echo $((pct < 99 ? pct : 99)); fi
    done
}

start=$SECONDS
if $gui; then
  # Prefetch runs as its own job (process group); the window only follows its progress file.
  # Pause (or closing the window) freezes the job, then asks whether to resume or stop.
  set -m
  run > "$status" &
  job=$!
  set +m
  # The job has its own process group, so stop it explicitly if this script is killed
  dialog_pid=
  trap 'kill -TERM -- -"$job" 2>/dev/null; kill -CONT -- -"$job" 2>/dev/null
        [[ -n $dialog_pid ]] && kill "$dialog_pid" 2>/dev/null; exit 1' TERM INT HUP
  # Runs a dialog in the background and waits for it. Bash only runs a trap once the foreground
  # command has finished, while `wait` is interrupted at once. The explicit <&0 keeps stdin,
  # which a background command would otherwise get replaced by /dev/null.
  dialog() { "$@" <&0 & dialog_pid=$!; wait "$dialog_pid"; }
  paused=0
  while kill -0 "$job" 2>/dev/null; do
    dialog zenity --progress --title="NAS prefetch" --width=500 --auto-close --cancel-label="Pause" \
      --text="Prefetching $count files ($(human "$total")) from ${dirs[*]}..." \
      < <(tail -n 2 -f --pid="$job" "$status") && break
    kill -0 "$job" 2>/dev/null || break
    kill -STOP -- -"$job" 2>/dev/null || true
    pause_start=$SECONDS
    if dialog zenity --question --default-cancel --title="NAS prefetch" --width=350 \
        --ok-label="Stop prefetch" --cancel-label="Resume" \
        --text="Prefetch paused: ${dirs[*]}\n\nFiles loaded so far stay cached."; then
      # A stopped process only acts on TERM once it is continued
      kill -TERM -- -"$job" 2>/dev/null || true
      kill -CONT -- -"$job" 2>/dev/null || true
      notify "Prefetch cancelled"
      exit 1
    fi
    paused=$((paused + SECONDS - pause_start))
    echo "$paused" > "$pausefile.tmp" && mv "$pausefile.tmp" "$pausefile"
    kill -CONT -- -"$job" 2>/dev/null || true
  done
  wait "$job" || true
else
  echo "Prefetching $count files ($(human "$total")) from ${dirs[*]}..."
  cols=$(tput cols 2>/dev/null || echo 80)
  shown_bw=
  run | while IFS= read -r line; do
    if [[ $line == '#'* ]]; then
      line=${line#\# Fetching: }
      IFS=$'\n' read -r -d '' folder totals bwline < <(printf '%s\0' "${line//\\n/$'\n'}") || true
      # The bandwidth line is printed once whenever it changes; the progress line shows
      # the totals first, then the folder
      if [[ -n $bwline && $bwline != "$shown_bw" ]]; then
        printf '\r\033[K%s\n' "$bwline"
        shown_bw=$bwline
      fi
      line="$totals  ·  $folder"
      printf '\r\033[K%s' "${line:0:cols-1}"
    fi
  done
  echo
fi
notify "Done: $count files ($(human "$total")) cached in $(((SECONDS - start) / 60)) min"
